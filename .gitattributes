# Normalize line endings to LF
* text=auto eol=lf

# Python files
*.py text diff=python
*.pyi text diff=python
*.pyw text diff=python
*.pxd text diff=python
*.pxi text diff=python
*.pyx text diff=python

# Config and metadata
*.cfg text
*.conf text
*.ini text
*.toml text
*.yaml text
*.yml text
*.json text
*.xml text
*.editorconfig text

# Documentation
*.md text diff=markdown
*.rst text
*.txt text

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Batch files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Git files
.gitattributes text
.gitignore text
.gitkeep text

# Makefile
Makefile text
makefile text
*.mk text

# Binary files - never modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.ttf binary
*.woff binary
*.woff2 binary
*.ico binary
*.icns binary
